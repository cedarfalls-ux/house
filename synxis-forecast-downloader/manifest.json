{
  "manifest_version": 3,
  "name": "SynXis Forecast Auto Downloader",
  "short_name": "Forecast Downloader",
  "version": "2.1.0",
  "description": "Downloads the SynXis Property Hub Forecast report (Next Year) as CSV once a day or on demand, and auto-refreshes chosen sites after inactivity.",
  "minimum_chrome_version": "111",
  "permissions": [
    "alarms",
    "storage",
    "downloads",
    "scripting",
    "notifications",
    "contentSettings",
    "contextMenus",
    "idle",
    "power",
    "background"
  ],
  "host_permissions": ["https://*.synxis.com/*"],
  "optional_host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "SynXis Forecast Downloader",
    "default_popup": "options.html?popup=1",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "options_page": "options.html",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
