{
  "manifest_version": 3,
  "name": "SynXis Forecast Auto Downloader",
  "short_name": "Forecast Downloader",
  "version": "1.0.0",
  "description": "Downloads the SynXis Property Hub Forecast report (Next Year) as CSV every night, or on demand, into a folder you choose.",
  "minimum_chrome_version": "111",
  "permissions": [
    "alarms",
    "storage",
    "downloads",
    "scripting",
    "notifications",
    "contentSettings",
    "background"
  ],
  "host_permissions": ["https://*.synxis.com/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "SynXis Forecast Downloader",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "options_page": "options.html",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
